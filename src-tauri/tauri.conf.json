{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoPassDoc",
  "version": "0.3.0",
  "identifier": "com.autopassdoc.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoPassDoc",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' apd: http://apd.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "按批注智能改稿的 Word 桌面工具",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": false }
    }
  }
}
